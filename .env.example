# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# InsForge (copy these settings to .env.local)
NEXT_PUBLIC_INSFORGE_URL=https://y3iqqeym.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-insforge-anon-key

# Server-only direct PostgreSQL connection (copy from the InsForge dashboard)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_DATABASE_HOST:5432/insforge?sslmode=require

# Inngest Background Jobs & Cron Scheduler
# Local Dev: Run `npm run inngest:dev` (no keys required locally)
# Production: Set Event Key & Signing Key from Inngest Dashboard (https://app.inngest.com)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
